    MoveType type;       // Тип хода
    struct MoveLog* next;
} MoveLog;

// Очередь (FIFO)
typedef struct {
    MoveLog* head;       // Первый элемент
    MoveLog* tail;       // Последний элемент
    int count;           // Текущее количество (макс 6)
} MoveLogger;

